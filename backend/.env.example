# Environment configuration for Crypto Wealth Maximizer v2.0 Backend
# Copy to .env for local overrides if needed. Never commit real secrets.

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional override; defaults to <repo_root>/data/crypto_daily_prices.csv
# CRYPTO_DATA_FILE=data/crypto_daily_prices.csv
BACKEND_CACHE_SIZE=64

